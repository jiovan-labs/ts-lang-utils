{
    "name": "@jiovan-labs/ts-lang-utils",
    "version": "2.0.1",
    "title": "Typescript Lang Utils",
    "description": "Common lang utilities for typescript",
    "homepage": "https://jiovan-labs.github.io/ts-lang-utils",
    "organization": "Jiovan Ltd",
    "private": false,
    "license": "MIT",
    "keywords": [
        "commons-lang",
        "array-utils",
        "boolean-utils",
        "color-utils",
        "date-utils",
        "duration-utils",
        "element-utils",
        "file-utils",
        "image-utils",
        "json-utils",
        "map-utils",
        "nanoid-utils",
        "number-utils",
        "object-utils",
        "random-utils",
        "regex-utils",
        "sensitive-utils",
        "string-utils",
        "thread-utils",
        "tree-utils",
        "uri-utils",
        "cookie-storage",
        "local-storage",
        "session-storage"
    ],
    "files": [
        "dist"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "unpkg": "dist/umd/ts-lang-utils.min.js",
    "types": "dist/esm/index.d.ts",
    "sideEffects": false,
    "scripts": {
        "approve": "npm approve-scripts --allow-scripts-pending",
        "build": "del-cli ./dist && father build",
        "doctor": "father doctor",
        "docs:build": "typedoc --out ./docs-dist",
        "docs:publish": "gh-pages -d ./docs-dist",
        "lint": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "lint:fix": "eslint --fix \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "test": "jest",
        "test:coverage": "del-cli ./coverage && jest --coverage --coverageDirectory ./coverage",
        "upgrade": "npx npm-check-updates --target semver -u"
    },
    "dependencies": {
        "@babel/runtime": "^7.29.10",
        "@imranbarbhuiya/duration": "^5.1.8",
        "libphonenumber-js": "^1.13.15",
        "lodash": "^4.18.1",
        "nanoid": "^3.3.20",
        "universal-cookie": "^8.1.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.27",
        "@jiovan-labs/babel-plugin-remove-comment": "^2.0.0",
        "@jiovan-labs/typedoc-plugin-raw-content": "^2.0.0",
        "@jiovan-labs/typedoc-theme-dumi": "^2.0.0",
        "del-cli": "^7.0.0",
        "eslint": "^10.14.0",
        "eslint-plugin-jest": "^29.17.0",
        "father": "^4.6.41",
        "gh-pages": "^6.3.0",
        "globals": "^17.14.0",
        "jest-environment-jsdom": "^30.5.2",
        "ts-jest": "^29.4.15",
        "typedoc": "~0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "peerDependencies": {
        "typescript": ">=4.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jiovan-labs/ts-lang-utils.git"
    },
    "bugs": {
        "url": "https://github.com/jiovan-labs/ts-lang-utils/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "collective": {
        "url": "https://opencollective.com/jiovan-labs"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/jiovan-labs"
        },
        {
            "type": "individual",
            "url": "https://jiovan.com/donation"
        }
    ],
    "author": {
        "name": "Jiovan Ltd",
        "url": "https://jiovan.com"
    },
    "contributors": [
        {
            "name": "David Hsing",
            "email": "davidhsing@163.com",
            "url": "https://github.com/davidhsing"
        }
    ],
    "allowScripts": {
        "@parcel/watcher": true,
        "core-js": true,
        "core-js-pure": true,
        "esbuild": true,
        "fsevents": true,
        "unrs-resolver": true
    }
}
